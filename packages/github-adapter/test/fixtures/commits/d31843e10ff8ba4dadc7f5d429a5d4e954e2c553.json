        "patch": "@@ -0,0 +1,13 @@\n+GEM\n+  remote: https://rubygems.org/\n+  specs:\n+    git (1.5.0)\n+\n+PLATFORMS\n+  ruby\n+\n+DEPENDENCIES\n+  git\n+\n+BUNDLED WITH\n+   2.0.2"
